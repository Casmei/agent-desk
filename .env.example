NODE_ENV=development
PORT=3000
# Nest log levels: fatal | error | warn | log | debug | verbose (this level and the more severe ones)
LOG_LEVEL=log
# Postgres credentials used by docker compose. DATABASE_URL below must match them.
POSTGRES_USER=agent_desk
POSTGRES_PASSWORD=agent_desk
POSTGRES_DB=agent_desk
DATABASE_URL=postgres://agent_desk:agent_desk@localhost:5432/agent_desk
REDIS_URL=redis://localhost:6379
# Required: the API does not start without a value of 32 or more characters (e.g. openssl rand -hex 32).
ADMIN_TOKEN=
# Required: 64 hexadecimal characters (openssl rand -hex 32). Encrypts the stored secrets (Evolution token, OpenRouter key).
# Keep it safe: losing or changing it makes every stored secret unreadable, and they must be registered again.
SECRET_ENCRYPTION_KEY=
TOOL_WEBHOOK_TIMEOUT_MS=10000
# Evolution API (docker compose --profile evolution up -d). Its database ("evolution") is created by Evolution itself in the shared Postgres.
EVOLUTION_API_KEY=change-me-evolution-api-key
# OpenTelemetry (traces, metrics and logs). Instrumentation is off while OTEL_EXPORTER_OTLP_ENDPOINT is empty.
# OTEL_SERVICE_NAME=agent-desk-api
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<openobserve>/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of email:password>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
