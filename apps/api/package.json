{
  "name": "@agent-desk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --env-file ../../.env",
    "build": "nest build",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/terminus": "12.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "envalid": "^9.0.0",
    "ioredis": "^6.1.0",
    "postgres": "^4.1.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@agent-desk/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.0.0",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
