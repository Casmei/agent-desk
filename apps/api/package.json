{
  "name": "@agent-desk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "envalid": "^9.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@agent-desk/eslint-config": "workspace:*",
    "@agent-desk/tsconfig": "workspace:*",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
