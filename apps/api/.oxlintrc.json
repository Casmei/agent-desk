{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
    "no-console": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["**/modules/*/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!./**", "!node:crypto"],
                "message": "The domain may only import from its own domain layer and node:crypto."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/modules/*/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nestjs/common",
                "allowImportNames": ["Injectable"],
                "message": "The application layer may only use Injectable from @nestjs/common."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@nestjs/**",
                  "!@nestjs/common",
                  "@nestjs/common/**",
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "postgres",
                  "ioredis",
                  "bullmq",
                  "envalid"
                ],
                "message": "The application layer must not depend on frameworks or drivers."
              },
              {
                "group": [
                  "**/infrastructure/**",
                  "**/interface/**",
                  "**/shared/**",
                  "../../*/domain/**"
                ],
                "message": "The application layer may only import its own domain and application layers, or another module's application layer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/modules/*/infrastructure/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/interface/**",
                  "../../*/domain/**",
                  "../../*/infrastructure/**"
                ],
                "message": "The infrastructure layer may only import its own domain and application layers, shared, or another module's application layer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/modules/*/interface/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/domain/**",
                  "!../domain/*.error.js",
                  "**/infrastructure/**",
                  "../../*/interface/**"
                ],
                "message": "The interface layer may only import application layers, shared, and its own domain errors."
              }
            ]
          }
        ]
      }
    }
  ]
}
