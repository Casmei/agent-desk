{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "ADMIN_TOKEN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
